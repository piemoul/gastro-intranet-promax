APP_URL=http://localhost:3100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production uses the existing Neon database with separate intranet_ tables.
# Omit DATABASE_URL only for local SQLite development.
DATABASE_URL=
# Optional integration tests: direct/unpooled connection; never set on Vercel.
INTRANET_TEST_DATABASE_URL=
INTRANET_WMS_ENV_FILE="/Users/user/Documents/coding disini/gastro-wms/.env"
# On Vercel, set the following values directly instead of INTRANET_WMS_ENV_FILE.
# ACCURATE_HOST=https://iris.accurate.id
# ACCURATE_SIGNATURE_KEY=
# ACCURATE_API_TOKEN=
# ACCURATE_API_TOKEN_RSP=
# ACCURATE_API_TOKEN_SARANA=
# INTRANET_DATA_DIR=/absolute/path/to/intranet-data
