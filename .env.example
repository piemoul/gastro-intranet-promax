APP_URL=http://localhost:3100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production uses the existing Neon database with separate intranet_ tables.
# Omit DATABASE_URL only for local SQLite development.
DATABASE_URL=
# Optional integration tests: direct/unpooled connection; never set on Vercel.
INTRANET_TEST_DATABASE_URL=
# Docker uses only this app's own Accurate environment; no WMS file is mounted.
INTRANET_WMS_ENV_FILE=
# Supply all Accurate credentials in .env.local (or deployment environment).
ACCURATE_HOST=https://iris.accurate.id
ACCURATE_SIGNATURE_KEY=
ACCURATE_API_TOKEN=
ACCURATE_API_TOKEN_RSP=
ACCURATE_API_TOKEN_SARANA=
# Server-to-server references. Never use NEXT_PUBLIC_ for keys.
INTRANET_PORTAL_API_URL=http://host.docker.internal:3035/api/integrations/intranet
INTRANET_PORTAL_API_KEY=
INTRANET_WMS_API_URL=http://wms-read-api:3110/v1/catalog
INTRANET_WMS_API_KEY=
# INTRANET_DATA_DIR=/absolute/path/to/intranet-data
