# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Session (>= 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# Legacy system — scraper is STRICTLY READ-ONLY (GET only)
LEGACY_BASE_URL=https://intra.gastro.co.id
LEGACY_USER=you@gastro.co.id
LEGACY_PASSWORD=
# Preferred: paste a logged-in session cookie so the scraper never writes (not even login).
LEGACY_COOKIE=

# Optional: dev admin password used by npm run db:seed (falls back to LEGACY_PASSWORD)
SEED_ADMIN_PASSWORD=
